{
  "name": "webforj-tutorial-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end and visual regression tests for the webforJ tutorial steps",
  "scripts": {
    "e2e": "node e2e/scripts/run-steps.mjs",
