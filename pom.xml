<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.webforj.tutorial</groupId>
  <artifactId>tutorial-e2e</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>webforJ Tutorial End-to-End Tests</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <playwright.version>1.50.0</playwright.version>
    <junit.version>5.11.4</junit.version>
    <docker.image>webforj-tutorial-e2e:playwright-${playwright.version}</docker.image>
    <it.test>*IT</it.test>
    <updateScreenshots>false</updateScreenshots>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The outer Maven process only orchestrates Docker. -->
    <profile>
      <id>docker-e2e</id>
      <activation>
        <property>
          <name>!docker.e2e.container</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>docker-e2e-build</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <arguments>
                    <argument>build</argument>
                    <argument>-t</argument>
                    <argument>${docker.image}</argument>
                    <argument>.</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>docker-e2e</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>--rm</argument>
                    <argument>--init</argument>
                    <argument>--ipc=host</argument>
                    <argument>-e</argument>
                    <argument>CI=true</argument>
                    <argument>-e</argument>
                    <argument>E2E_IN_DOCKER=true</argument>
                    <argument>--mount=type=bind,source=${project.basedir},target=/app</argument>
                    <argument>-v</argument>
                    <argument>webforj-tutorial-e2e-maven-repo:/var/maven/.m2</argument>
                    <argument>-e</argument>
                    <argument>MAVEN_CONFIG=/var/maven/.m2</argument>
                    <argument>${docker.image}</argument>
                    <argument>mvn</argument>
                    <argument>-ntp</argument>
                    <argument>-Dmaven.repo.local=/var/maven/.m2/repository</argument>
                    <argument>-Ddocker.e2e.container=true</argument>
                    <argument>-DupdateScreenshots=${updateScreenshots}</argument>
                    <argument>-Dit.test=${it.test}</argument>
                    <argument>verify</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>docker-e2e-single</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>--rm</argument>
                    <argument>--init</argument>
                    <argument>--ipc=host</argument>
                    <argument>-e</argument>
                    <argument>CI=true</argument>
                    <argument>-e</argument>
                    <argument>E2E_IN_DOCKER=true</argument>
                    <argument>--mount=type=bind,source=${project.basedir},target=/app</argument>
                    <argument>-v</argument>
                    <argument>webforj-tutorial-e2e-maven-repo:/var/maven/.m2</argument>
                    <argument>-e</argument>
                    <argument>MAVEN_CONFIG=/var/maven/.m2</argument>
                    <argument>${docker.image}</argument>
                    <argument>mvn</argument>
                    <argument>-ntp</argument>
                    <argument>-Dmaven.repo.local=/var/maven/.m2/repository</argument>
                    <argument>-Ddocker.e2e.container=true</argument>
                    <argument>-DupdateScreenshots=false</argument>
                    <argument>-Dit.test=${test}</argument>
                    <argument>verify</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>docker-e2e-update</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>--rm</argument>
                    <argument>--init</argument>
                    <argument>--ipc=host</argument>
                    <argument>-e</argument>
                    <argument>CI=true</argument>
                    <argument>-e</argument>
                    <argument>E2E_IN_DOCKER=true</argument>
                    <argument>--mount=type=bind,source=${project.basedir},target=/app</argument>
                    <argument>-v</argument>
                    <argument>webforj-tutorial-e2e-maven-repo:/var/maven/.m2</argument>
                    <argument>-e</argument>
                    <argument>MAVEN_CONFIG=/var/maven/.m2</argument>
                    <argument>${docker.image}</argument>
                    <argument>mvn</argument>
                    <argument>-ntp</argument>
                    <argument>-Dmaven.repo.local=/var/maven/.m2/repository</argument>
                    <argument>-Ddocker.e2e.container=true</argument>
                    <argument>-DupdateScreenshots=true</argument>
                    <argument>-Dit.test=${it.test}</argument>
                    <argument>verify</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- This profile is entered only by the Maven process inside Docker. -->
    <profile>
      <id>container-e2e</id>
      <activation>
        <property>
          <name>docker.e2e.container</name>
          <value>true</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.microsoft.playwright</groupId>
          <artifactId>playwright</artifactId>
          <version>${playwright.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-api</artifactId>
          <version>${junit.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-engine</artifactId>
          <version>${junit.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>add-e2e-test-source</id>
                <phase>generate-test-sources</phase>
                <goals><goal>add-test-source</goal></goals>
                <configuration>
                  <sources>
                    <source>${project.basedir}/e2e/src/test/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-e2e-test-resources</id>
                <phase>generate-test-resources</phase>
                <goals><goal>add-test-resource</goal></goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/e2e/src/test/resources</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>build-step-1</id>
                <phase>pre-integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>mvn</executable>
                  <arguments><argument>-ntp</argument><argument>-f</argument><argument>${project.basedir}/1-creating-a-basic-app/pom.xml</argument><argument>-DskipTests</argument><argument>package</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>build-step-2</id>
                <phase>pre-integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>mvn</executable>
                  <arguments><argument>-ntp</argument><argument>-f</argument><argument>${project.basedir}/2-working-with-data/pom.xml</argument><argument>-DskipTests</argument><argument>package</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>build-step-3</id>
                <phase>pre-integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>mvn</executable>
                  <arguments><argument>-ntp</argument><argument>-f</argument><argument>${project.basedir}/3-routing-and-composites/pom.xml</argument><argument>-DskipTests</argument><argument>package</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>build-step-4</id>
                <phase>pre-integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>mvn</executable>
                  <arguments><argument>-ntp</argument><argument>-f</argument><argument>${project.basedir}/4-observers-and-route-parameters/pom.xml</argument><argument>-DskipTests</argument><argument>package</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>build-step-5</id>
                <phase>pre-integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>mvn</executable>
                  <arguments><argument>-ntp</argument><argument>-f</argument><argument>${project.basedir}/5-validating-and-binding-data/pom.xml</argument><argument>-DskipTests</argument><argument>package</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>build-step-6</id>
                <phase>pre-integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>mvn</executable>
                  <arguments><argument>-ntp</argument><argument>-f</argument><argument>${project.basedir}/6-integrating-an-app-layout/pom.xml</argument><argument>-DskipTests</argument><argument>package</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.2.5</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
              <trimStackTrace>false</trimStackTrace>
              <useFile>false</useFile>
              <systemPropertyVariables>
                <visual.baseline.dir>${project.basedir}/e2e/src/test/resources/screenshots</visual.baseline.dir>
                <visual.artifact.dir>${project.build.directory}/visual-diffs</visual.artifact.dir>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
